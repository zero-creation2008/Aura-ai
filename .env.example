# AURA configuration — copy this to .env and adjust as needed.
# No cloud API keys are used anywhere in this system.

# Ollama (local LLM server)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# Storage
AURA_DB_PATH=./aura.db
AURA_WORKSPACE=./workspace

# Agent loop limits
AURA_MAX_ITERATIONS=8
AURA_MAX_TASK_SECONDS=300

# Autonomy: manual | semi_autonomous | autonomous
# Note: dangerous actions (delete_file, run_shell, install_package,
# merge_pull_request) ALWAYS require approval regardless of this setting.
# Committing/pushing a FEATURE BRANCH is allowed automatically once tests
# pass — but merging that branch into main always happens on GitHub itself,
# by you. AURA never merges its own pull requests.
AURA_AUTONOMY_MODE=semi_autonomous

# GitHub self-improvement (optional — leave blank to disable this feature)
# Generate a token at https://github.com/settings/tokens with "repo" scope.
# Never commit a real token. This file (.env) is already gitignored.
GITHUB_TOKEN=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
GITHUB_REPO=zero-creation2008/Aura-ai
GITHUB_BASE_BRANCH=main

# Server
AURA_HOST=127.0.0.1
AURA_PORT=8787
AURA_DEBUG=0
